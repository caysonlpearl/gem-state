# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key

# Direct Postgres connection used only by Drizzle migration tooling
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Active Gem State marketplace origin used for listing-upgrade redirects
GEM_STATE_SITE_URL=https://gemstateclassifieds.com

# Legacy marketplace integrations retained for compatibility during migration
PARKVAULT_SITE_URL=https://your-production-domain.example
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
SHIPPO_API_TOKEN=
CRON_SECRET=
CRON_SECRET_PREVIOUS=

# Adzuna job search; server-only, never prefix these with VITE_.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# OpenWeb Ninja real-time Zillow and real-estate data; server-only, never prefix with VITE_.
OPENWEBNINJA_API_KEY=

# OpenWeb Ninja Local Business Data. Use a key from the local-business
# account so its business quota is isolated from the home feeds.
OPENWEBNINJA_LOCAL_BUSINESS_API_KEY=

# logo.dev employer logos on partner jobs. Both are read on the server; the
# publishable key (pk_) ends up in image URLs, the secret key (sk_) never leaves it.
LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SECRET_KEY=

# Resend-first transactional email. The onboarding@resend.dev sender is for test
# delivery only; replace RESEND_FROM_EMAIL after verifying a Gem State domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Gem State Classifieds <onboarding@resend.dev>

# Foursquare. The OS Places token (Places Portal > OS Places > Access Data,
# lasts a month) is only needed to run tools/foursquare/import_services.py;
# the live site never reads it. The Places API key is optional.
FOURSQUARE_OS_TOKEN=
FOURSQUARE_PLACES_TOKEN=
