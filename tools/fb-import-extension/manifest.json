{
  "manifest_version": 3,
  "name": "Bluebird Listing Import",
  "version": "1.5.2",
  "description": "With a seller's permission, imports Facebook, KSL, Vinted, Whatnot and Diesel Depot inventory in two reader windows. Runs only when requested.",
  "permissions": ["debugger", "scripting", "tabs", "clipboardWrite"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://classifieds.ksl.com/*",
    "https://image.ksldigital.com/*",
    "https://images.whatnot.com/*",
    "https://www.whatnot.com/*",
    "https://*.vinted.net/*",
    "https://www.vinted.com/*",
    "https://onbluebird.com/*",
    "https://www.onbluebird.com/*",
    "https://gem-state.lovable.app/*",
    "https://gemstateclassifieds.lovable.app/*",
    "https://www.diesel-depot.com/*",
    "https://diesel-depot.com/*",
    "https://media.sandhills.com/*"
  ],
  "action": {
    "default_title": "Import this seller's listings to Bluebird"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onbluebird.com/*",
        "https://www.onbluebird.com/*",
        "https://gem-state.lovable.app/*",
        "https://gemstateclassifieds.lovable.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
