{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"], "jsx": "react-jsx",
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "types": ["vite/client"], "paths": { "@/*": ["../../src/*"] }
  },
  "include": ["src", "capacitor.config.ts", "vite.config.ts"]
}
